# Copy to client/.env for local development. Never commit real secrets.

# SLAP API is proxied by Vite (/api → http://localhost:5000).
# Keycloak OIDC (same SELVIA realm; dedicated public client).
# Browser calls Keycloak directly — slap-frontend Web origins must include this app origin.
VITE_KEYCLOAK_URL=https://auth-mentor.duckdns.org/auth
# Local Kong alternative:
# VITE_KEYCLOAK_URL=http://localhost:8000/auth
VITE_KEYCLOAK_REALM=mentor
VITE_KEYCLOAK_CLIENT_ID=slap-frontend

# When true, Login page also shows the local email/password form (dev only).
VITE_ALLOW_LOCAL_PASSWORD_LOGIN=false
