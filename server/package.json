{
  "name": "selvia-learning-platform-server",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js + Express API for the SELVIA External Education & Assessment Platform",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "ops:ensure-dev-accounts": "node scripts/ensure-dev-login-accounts.js",
    "ops:provision-external-identity": "node scripts/provision-admin-verified-external-identity.js",
    "graph:schema": "node scripts/graph-schema.js",
    "test:unit": "node --test tests/studentEvidence.test.js tests/learningActivityQuery.test.js tests/tutorToken.test.js tests/tutorFacingContract.test.js tests/mcpServer.unit.test.js tests/externalIdentity.unit.test.js tests/tutorAccessToken.unit.test.js tests/graphAutoSync.unit.test.js tests/keycloakAuth.unit.test.js",
    "test:db-guard": "node --test tests/testDatabaseGuard.test.js tests/prismaTestConfig.test.js tests/testDatabaseIdentity.test.js tests/postgresEnvironment.test.js tests/testDatabaseMigration.test.js",
    "test:db:check": "node scripts/check-test-database.js",
    "test:db:verify": "node scripts/verify-test-database.js",
    "test:db:migrate": "node scripts/migrate-test-database.js",
    "test:integration:runner": "node --test tests/integrationRunner.test.js tests/integrationEntry.test.js tests/testEnvironmentIsolation.test.js",
    "test:integration:safe": "node tests/run-integration-tests.js"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "prisma": "^7.10.0"
  }
}
