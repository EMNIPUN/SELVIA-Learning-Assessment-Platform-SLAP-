# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------
# PostgreSQL (Prisma)
# ---------------------------------------------------------------
# URL-encode special characters in the password (for example @ -> %40).
#
# DATABASE_URL is used by the running application. With Supabase, use the
# transaction-mode pooler (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
#
# DIRECT_URL is used by the Prisma CLI (migrations). It must be a session-mode
# or direct connection (Supabase session pooler, port 5432). Leave it unset for
# a local PostgreSQL server; DATABASE_URL is used instead.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
#
# Integration tests (npm run test:integration:safe) and test migrations
# (npm run test:db:migrate) never use this file: set both DATABASE_URL and
# DIRECT_URL in the terminal, pointing to the same local *_test database.
# See server/tests/integration/README.md.

# ---------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------
# Use a long random value in every real environment, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-this-in-production"
JWT_EXPIRES_IN="1d"

# ---------------------------------------------------------------
# Neo4j (Course Knowledge Graph)
# ---------------------------------------------------------------
# Neo4j Aura: neo4j+s://<instance-id>.databases.neo4j.io
# Local Neo4j: neo4j://localhost:7687 (or bolt://localhost:7687)
# If any of URI, username or password is missing, the API still starts and
# the health check reports Neo4j as "not_configured".
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
# Defaults to "neo4j" when unset.
NEO4J_DATABASE=neo4j
# Informational only (Aura console); not read by the application.
AURA_INSTANCEID=YOUR_INSTANCE_ID
AURA_INSTANCENAME=YOUR_INSTANCE_NAME

# ---------------------------------------------------------------
# Future configuration (not used yet)
# ---------------------------------------------------------------

# Frontend origin (React + Vite dev server)
# CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------
# MCP tutor-token auth (optional; platform starts without these)
# ---------------------------------------------------------------
# Cross-repo live-test prep (J26 + SLAP), placeholders only:
#   ../../J26-SE-363/docs/MCP_LIVE_TEST_CHECKLIST.md
# (Adjust the relative path if your checkout layout differs.)
# Used only for Adaptive AI Tutor sessions against the /mcp endpoint.
# Must be a long random value and MUST differ from JWT_SECRET. Example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MCP_TUTOR_TOKEN_SECRET=
# Absolute URL of this platform's MCP resource (token audience), for example:
# MCP_RESOURCE_URL=http://localhost:5000/mcp
# Optional issuer override; defaults to "selvia-platform".
# MCP_TUTOR_TOKEN_ISSUER=selvia-platform

# ---------------------------------------------------------------
# Internal tutor-access-token mint (J26 Core API only)
# ---------------------------------------------------------------
# Shared secret for POST /api/v1/internal/tutor-access-tokens.
# Used only by the trusted J26 Core API to mint short-lived tutor MCP tokens
# after Keycloak issuer+subject resolution. Never expose this value to browsers,
# students, the Adaptive AI Tutor Python process, or the AI Backend.
# Must be at least 32 characters and MUST differ from JWT_SECRET and
# MCP_TUTOR_TOKEN_SECRET. Example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# INTERNAL_TUTOR_MINT_TOKEN=
# Minted tokens use fixed scopes tutor:evidence.read and tutor:activity.read,
# default lifetime 300s (max 900s), and MCP_RESOURCE_URL as the audience.

